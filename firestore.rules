rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validAttachment(a) {
      return a is map &&
        a.keys().hasOnly(['name', 'type', 'size', 'data']) &&
        a.name is string && a.name.size() > 0 && a.name.size() <= 120 &&
        a.type is string &&
        a.type.matches('^(image/(jpeg|png|webp|gif)|application/pdf|text/plain|application/zip)$') &&
        a.size is int && a.size > 0 && a.size <= 256000 &&
        a.data is string && a.data.size() <= 350000;
    }

    function validAttachments(data) {
      return !('attachments' in data) ||
        (data.attachments is list && data.attachments.size() <= 3 &&
          (data.attachments.size() < 1 || validAttachment(data.attachments[0])) &&
          (data.attachments.size() < 2 || validAttachment(data.attachments[1])) &&
          (data.attachments.size() < 3 || validAttachment(data.attachments[2])));
    }

    match /feedback/{docId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['projectNumber','projectName','category','comment','author','status','createdAt','attachments']) &&
        request.resource.data.projectNumber is string &&
        request.resource.data.projectNumber.size() == 2 &&
        request.resource.data.projectName is string &&
        request.resource.data.projectName.size() > 0 && request.resource.data.projectName.size() <= 60 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 30 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 500 &&
        (!('author' in request.resource.data) ||
          (request.resource.data.author is string && request.resource.data.author.size() <= 40)) &&
        validAttachments(request.resource.data) &&
        // every new feedback starts out 대기중(pending) — only an admin update can move it on
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','comment','updatedAt','reply','repliedAt']) &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 500 &&
        request.resource.data.status in ['pending','in_progress','done'];
      allow delete: if request.auth != null;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if
          request.resource.data.keys().hasOnly(['feedbackId','role','author','parentReplyId','message','acknowledged','createdAt']) &&
          request.resource.data.feedbackId == docId &&
          request.resource.data.message is string &&
          request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 500 &&
          request.resource.data.createdAt == request.time &&
          (
            (request.auth != null && request.resource.data.role == 'admin' &&
              request.resource.data.parentReplyId == '' && request.resource.data.acknowledged == false) ||
            (request.auth == null && request.resource.data.role == 'user' &&
              request.resource.data.parentReplyId is string && request.resource.data.parentReplyId.size() > 0 &&
              get(/databases/$(database)/documents/feedback/$(docId)/replies/$(request.resource.data.parentReplyId)).data.role == 'admin' &&
              !('acknowledged' in request.resource.data))
          );
        allow update: if
          (request.auth != null) ||
          (request.auth == null && resource.data.role == 'admin' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged','acknowledgedAt']) &&
            request.resource.data.acknowledged == true &&
            request.resource.data.acknowledgedAt == request.time);
        allow delete: if request.auth != null;
      }
    }

    // collectionGroup('replies') 실시간 조회를 위한 재귀 읽기 규칙입니다.
    match /{path=**}/replies/{replyId} {
      allow read: if true;
    }

    match /projects/{docId} {
      // 공개 사이트(js/main.js)는 누구나 읽을 수 있어야 마퀴/프로젝트 목록/피드백 선택기가 뜹니다.
      allow read: if true;
      // 프로젝트 추가/수정/삭제는 로그인한 관리자만 (admin/ 대시보드의 프로젝트 관리 탭).
      allow create, update, delete: if request.auth != null;
    }

    function validSiteContentString(v) {
      return v is string && v.size() <= 2000;
    }
    // 홈페이지 문구(히어로/프로젝트·피드백 섹션 헤드/로고/푸터) — 공개 사이트가
    // 읽어 렌더링하므로 누구나 읽기 가능, 저장은 로그인한 관리자만
    // (admin/ 대시보드의 "홈페이지 관리" 탭). 문서 1개 = 섹션 1개
    // (hero/projects/feedback/logo/footer).
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'eyebrow','title','subtext',
          'button1Label','button1Link','button2Label','button2Link',
          'text','tagline','infoLine1','infoLine2','updatedAt'
        ]) &&
        (!('eyebrow' in request.resource.data) || validSiteContentString(request.resource.data.eyebrow)) &&
        (!('title' in request.resource.data) || validSiteContentString(request.resource.data.title)) &&
        (!('subtext' in request.resource.data) || validSiteContentString(request.resource.data.subtext)) &&
        (!('button1Label' in request.resource.data) || validSiteContentString(request.resource.data.button1Label)) &&
        (!('button1Link' in request.resource.data) || validSiteContentString(request.resource.data.button1Link)) &&
        (!('button2Label' in request.resource.data) || validSiteContentString(request.resource.data.button2Label)) &&
        (!('button2Link' in request.resource.data) || validSiteContentString(request.resource.data.button2Link)) &&
        (!('text' in request.resource.data) || validSiteContentString(request.resource.data.text)) &&
        (!('tagline' in request.resource.data) || validSiteContentString(request.resource.data.tagline)) &&
        (!('infoLine1' in request.resource.data) || validSiteContentString(request.resource.data.infoLine1)) &&
        (!('infoLine2' in request.resource.data) || validSiteContentString(request.resource.data.infoLine2));
    }
  }
}
